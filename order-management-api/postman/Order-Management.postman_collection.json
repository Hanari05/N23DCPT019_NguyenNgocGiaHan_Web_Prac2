{
  "info": {
    "name": "Lab 2 - Order Management API",
    "description": "Import collection; run POST first to set orderId, then GET/PUT/DELETE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Tao don hang (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "pm.test('Created order', () => { pm.expect(data._id).to.be.a('string'); pm.expect(data.status).to.eql('pending'); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('orderId', data._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Nguyen Ngoc Gia Han\",\n  \"customerEmail\": \"giahan@email.com\",\n  \"items\": [\n    { \"productName\": \"Laptop Dell XPS\", \"quantity\": 1, \"unitPrice\": 25000000 },\n    { \"productName\": \"Chuot Logitech\", \"quantity\": 2, \"unitPrice\": 500000 }\n  ],\n  \"totalAmount\": 26000000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
      "name": "2. Lay danh sach (GET)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Response is an array', () => pm.expect(data).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Lay theo ID (GET)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/{{orderId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Correct ID', () => pm.expect(data._id).to.eql(pm.collectionVariables.get('orderId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Cap nhat trang thai (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"confirmed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/orders/{{orderId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Correct ID', () => pm.expect(data._id).to.eql(pm.collectionVariables.get('orderId')));",
              "pm.test('Updated status', () => pm.expect(data.status).to.eql('confirmed'));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Xoa don hang (DELETE)",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/orders/{{orderId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Message returned', () => pm.expect(data.message).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Loc pending",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders?status=pending"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Response is an array', () => pm.expect(data).to.be.an('array'));",
              "pm.test('All orders pending', () => data.forEach(x => pm.expect(x.status).to.eql('pending')));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Tong tien tang dan",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders?sort=asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Response is an array', () => pm.expect(data).to.be.an('array'));",
              "pm.test('Correct amount order', () => data.forEach((x, i) => { if (i) pm.expect(data[i-1].totalAmount).to.be.at.most(x.totalAmount); }));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Tong tien giam dan",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders?sort=desc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Response is an array', () => pm.expect(data).to.be.an('array'));",
              "pm.test('Correct amount order', () => data.forEach((x, i) => { if (i) pm.expect(data[i-1].totalAmount).to.be.at.least(x.totalAmount); }));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Ket hop loc va sap xep",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders?status=pending&sort=asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Response is an array', () => pm.expect(data).to.be.an('array'));",
              "pm.test('All orders pending', () => data.forEach(x => pm.expect(x.status).to.eql('pending')));",
              "pm.test('Correct amount order', () => data.forEach((x, i) => { if (i) pm.expect(data[i-1].totalAmount).to.be.at.most(x.totalAmount); }));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Tim ten khong phan biet hoa thuong",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/search?name=nguyen"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Response is an array', () => pm.expect(data).to.be.an('array'));",
              "pm.test('Name matches', () => data.forEach(x => pm.expect(x.customerName.toLowerCase()).to.include('nguyen')));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Tu choi status sai",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders?status=wrong"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "const data = pm.response.json();",
              "pm.test('Message returned', () => pm.expect(data.message).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Tu choi sort sai",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders?sort=wrong"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "const data = pm.response.json();",
              "pm.test('Message returned', () => pm.expect(data.message).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Tu choi thieu ten",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/search"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "const data = pm.response.json();",
              "pm.test('Message returned', () => pm.expect(data.message).to.be.a('string'));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://nguyenngocgiahan-lab2-ltw.onrender.com"
    },
    {
      "key": "orderId",
      "value": ""
    }
  ]
}
